{
  "name": "apitu",
  "version": "1.2.8",
  "private": true,
  "type": "module",
  "description": "本地交互式架构与流程图插件，内置完整图表核心。",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yueyexiayu/dsh-apitu.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "playwright-core": "1.58.2"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "install:headless": "playwright-core install chromium-headless-shell"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
